# Fair Drop Environment Configuration
# Copy to .env and adjust as needed

# Event Configuration
EVENT_ID=event_drop_001
EVENT_NAME=Fair Drop 500
EVENT_CAPACITY=500
WINDOW_SECONDS=300
HOLD_TTL_SECONDS=180
MIN_ACCOUNT_AGE_SECONDS=0
ADMISSION_BATCH_SIZE=50
CLUSTER_ALPHA=1.0
MAX_SEATS_PER_CLUSTER=1
BASE_POW_DIFFICULTY_BITS=14

# Defense Toggles (all default to true except phone OTP)
DEF_OTP=true
DEF_OTP_PHONE=false
DEF_ACCOUNT_AGE=false
DEF_CANONICAL_DEDUPE=true
DEF_POW=true
DEF_RATE_LIMITS=true
DEF_CLUSTER_WEIGHT=true
DEF_RISK_SCORE=true
DEF_STEP_UP=true
DEF_TRUST_PROXY_HEADERS_CORRECTLY=true

# Secrets (generate secure random strings in production)
HMAC_SECRET_KEY=dev-hmac-secret-at-least-32-bytes-long!
PEPPER_SECRET_KEY=dev-phone-pepper-32-bytes-long!
ADMIN_TOKEN=fairdrop-admin-supersecret-token

# OTP Provider: 'sim', 'mailpit', 'email_brevo', 'email_gmail'
OTP_PROVIDER=mailpit
PHONE_OTP_MODE=off
PHONE_OTP_ALLOWLIST=+15550192834,+919876543210

# Brevo SMTP (optional, if OTP_PROVIDER=email_brevo)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_EMAIL=fairdrop@example.com

# Mailpit (local dev SMTP sink)
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025

# Twilio SMS (optional, for allowlisted team numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Infrastructure
DATABASE_URL=postgresql://fairdrop:fairdrop_password@postgres:5432/fairdrop_db
REDIS_URL=redis://redis:6379/0
TRUSTED_PROXY_CIDR=172.16.0.0/12,127.0.0.1/32

# Node / Vite
VITE_API_URL=/api
PORT=8000
